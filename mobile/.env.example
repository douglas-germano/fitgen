# Copy to .env.local to point the app at another backend (e.g. your machine's LAN IP).
EXPO_PUBLIC_API_URL=https://fitgen.suacozinha.site/api
EXPO_PUBLIC_WEB_URL=https://fitgen.suacozinha.site

# Crash reporting / analytics (both optional; off in dev builds unless EXPO_PUBLIC_ANALYTICS_IN_DEV=1)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
