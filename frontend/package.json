{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "build:admin": "vite build --config vite.admin.config.mts && npm run check:admin && node admin/export-pages.mjs",
    "build:lp": "NEXT_OUTPUT=export next build --webpack && node scripts/prune-export.mjs lp",
    "build:pages": "npm run build:admin",
    "deploy:admin": "npm run build:admin && wrangler pages deploy out --project-name fitgen --branch main",
    "deploy:lp": "npm run build:lp && wrangler pages deploy out --project-name fitgen-lp --branch main",
    "dev:admin": "vite --config vite.admin.config.mts --port 3001 --strictPort",
    "check:admin": "tsc --project admin/tsconfig.json",
    "preview:admin": "wrangler pages dev out --port 3001"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.469.0",
    "next": "16.0.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^2.15.4",
    "sonner": "^1.7.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "8.3.8",
    "workbox-build": "7.1.1",
    "wrangler": "4.165.0"
  }
}
